[
  {
    "id": "timed-qr-test-001",
    "title": "QR Timed Test 1",
    "question_count": 36,
    "time_minutes": 26,
    "questions": [
      { "id": "tqr-q01", "stem": "A train travels 240 km in 3 hours. What is its average speed in km/h?", "options": [{"label": "A", "text": "60"}, {"label": "B", "text": "70"}, {"label": "C", "text": "80"}, {"label": "D", "text": "90"}, {"label": "E", "text": "100"}], "correct_answer": "C", "answer_reason": "Speed = distance ÷ time = 240 ÷ 3 = 80 km/h.", "order_index": 0 },
      { "id": "tqr-q02", "stem": "A shop sells a jacket for £84 after applying a 30% discount. What was the original price?", "options": [{"label": "A", "text": "£100"}, {"label": "B", "text": "£110"}, {"label": "C", "text": "£115"}, {"label": "D", "text": "£120"}, {"label": "E", "text": "£126"}], "correct_answer": "D", "answer_reason": "Original price × 0.70 = £84, so original = 84 ÷ 0.70 = £120.", "order_index": 1 },
      { "id": "tqr-q03", "stem": "A recipe for 6 people requires 450 g of flour. How much flour is needed for 10 people?", "options": [{"label": "A", "text": "650 g"}, {"label": "B", "text": "700 g"}, {"label": "C", "text": "720 g"}, {"label": "D", "text": "750 g"}, {"label": "E", "text": "800 g"}], "correct_answer": "D", "answer_reason": "Per person: 450 ÷ 6 = 75 g. For 10: 75 × 10 = 750 g.", "order_index": 2 },
      { "id": "tqr-q04", "stem": "A car uses 8 litres of fuel per 100 km. How many litres are needed for a 375 km journey?", "options": [{"label": "A", "text": "28"}, {"label": "B", "text": "30"}, {"label": "C", "text": "32"}, {"label": "D", "text": "36"}, {"label": "E", "text": "40"}], "correct_answer": "B", "answer_reason": "Fuel = (375 ÷ 100) × 8 = 3.75 × 8 = 30 litres.", "order_index": 3 },
      { "id": "tqr-q05", "stem": "A rectangle has a length of 14 cm and a width of 9 cm. What is its area?", "options": [{"label": "A", "text": "113 cm²"}, {"label": "B", "text": "116 cm²"}, {"label": "C", "text": "122 cm²"}, {"label": "D", "text": "126 cm²"}, {"label": "E", "text": "130 cm²"}], "correct_answer": "D", "answer_reason": "Area = 14 × 9 = 126 cm².", "order_index": 4 },
      { "id": "tqr-q06", "stem": "A bank account earns 4% simple interest per year. If £2,500 is deposited, how much interest is earned after 3 years?", "options": [{"label": "A", "text": "£200"}, {"label": "B", "text": "£250"}, {"label": "C", "text": "£300"}, {"label": "D", "text": "£312.50"}, {"label": "E", "text": "£325"}], "correct_answer": "C", "answer_reason": "Interest = 2500 × 0.04 × 3 = £300.", "order_index": 5 },
      { "id": "tqr-q07", "stem": "Three colleagues share a £960 bonus in the ratio 3:4:5. How much does the person with the largest share receive?", "options": [{"label": "A", "text": "£240"}, {"label": "B", "text": "£280"}, {"label": "C", "text": "£320"}, {"label": "D", "text": "£380"}, {"label": "E", "text": "£400"}], "correct_answer": "E", "answer_reason": "Total parts = 12. Largest share = (5 ÷ 12) × 960 = £400.", "order_index": 6 },
      { "id": "tqr-q08", "stem": "A tank holds 1,200 litres and is currently 35% full. How many litres are needed to fill it completely?", "options": [{"label": "A", "text": "420"}, {"label": "B", "text": "680"}, {"label": "C", "text": "720"}, {"label": "D", "text": "780"}, {"label": "E", "text": "860"}], "correct_answer": "D", "answer_reason": "Current = 35% × 1200 = 420 L. Needed = 1200 − 420 = 780 L.", "order_index": 7 },
      { "id": "tqr-q09", "stem": "A worker is paid £13.50 per hour and works 37.5 hours per week. What is their weekly pay?", "options": [{"label": "A", "text": "£487.50"}, {"label": "B", "text": "£500.00"}, {"label": "C", "text": "£506.25"}, {"label": "D", "text": "£513.75"}, {"label": "E", "text": "£520.00"}], "correct_answer": "C", "answer_reason": "Pay = 13.50 × 37.5 = £506.25.", "order_index": 8 },
      { "id": "tqr-q10", "stem": "A circular field has a radius of 7 m. What is its area? (Use π ≈ 3.14)", "options": [{"label": "A", "text": "143.98 m²"}, {"label": "B", "text": "150.72 m²"}, {"label": "C", "text": "153.86 m²"}, {"label": "D", "text": "158.42 m²"}, {"label": "E", "text": "163.28 m²"}], "correct_answer": "C", "answer_reason": "Area = π × r² = 3.14 × 49 = 153.86 m².", "order_index": 9 },
      { "id": "tqr-q11", "stem": "A phone costs £648 including 20% VAT. What is the pre-VAT price?", "options": [{"label": "A", "text": "£520"}, {"label": "B", "text": "£524"}, {"label": "C", "text": "£530"}, {"label": "D", "text": "£540"}, {"label": "E", "text": "£560"}], "correct_answer": "D", "answer_reason": "Pre-VAT = 648 ÷ 1.20 = £540.", "order_index": 10 },
      { "id": "tqr-q12", "stem": "A runner completes a 10 km race in 48 minutes. What is their speed in km/h?", "options": [{"label": "A", "text": "10.5"}, {"label": "B", "text": "11.5"}, {"label": "C", "text": "12.5"}, {"label": "D", "text": "13.5"}, {"label": "E", "text": "14.5"}], "correct_answer": "C", "answer_reason": "Speed = 10 ÷ (48/60) = 10 ÷ 0.8 = 12.5 km/h.", "order_index": 11 },
      { "id": "tqr-q13", "stem": "A house is valued at £320,000. It increases in value by 7.5%. What is the new value?", "options": [{"label": "A", "text": "£340,000"}, {"label": "B", "text": "£342,000"}, {"label": "C", "text": "£344,000"}, {"label": "D", "text": "£346,000"}, {"label": "E", "text": "£348,000"}], "correct_answer": "C", "answer_reason": "Increase = 320,000 × 0.075 = £24,000. New value = £344,000.", "order_index": 12 },
      { "id": "tqr-q14", "stem": "If 5 items cost £37.25 in total, what is the cost of 8 items?", "options": [{"label": "A", "text": "£55.60"}, {"label": "B", "text": "£57.20"}, {"label": "C", "text": "£59.60"}, {"label": "D", "text": "£61.00"}, {"label": "E", "text": "£62.80"}], "correct_answer": "C", "answer_reason": "Cost per item = 37.25 ÷ 5 = £7.45. For 8 items = 7.45 × 8 = £59.60.", "order_index": 13 },
      { "id": "tqr-q15", "stem": "A rectangle has perimeter 64 cm and length 20 cm. What is its area?", "options": [{"label": "A", "text": "220 cm²"}, {"label": "B", "text": "240 cm²"}, {"label": "C", "text": "260 cm²"}, {"label": "D", "text": "280 cm²"}, {"label": "E", "text": "300 cm²"}], "correct_answer": "B", "answer_reason": "Width = (64 ÷ 2) − 20 = 12 cm. Area = 20 × 12 = 240 cm².", "order_index": 14 },
      { "id": "tqr-q16", "stem": "A population of bacteria doubles every 3 hours. If there are 500 at noon, how many are there at 9 pm?", "options": [{"label": "A", "text": "4,000"}, {"label": "B", "text": "8,000"}, {"label": "C", "text": "16,000"}, {"label": "D", "text": "32,000"}, {"label": "E", "text": "64,000"}], "correct_answer": "C", "answer_reason": "9 hours = 3 doubling periods. 500 × 2³ = 500 × 8 = 4,000. Wait: 3 hours = ×2, 6 hours = ×4, 9 hours = ×8. 500 × 8 = 4,000. Selecting A. Actually answer is A: 4,000.", "correct_answer": "A", "answer_reason": "9 hours = 3 doublings. 500 × 2 × 2 × 2 = 4,000.", "order_index": 15 },
      { "id": "tqr-q17", "stem": "A map has a scale of 1:50,000. Two towns are 6 cm apart on the map. What is the real distance in km?", "options": [{"label": "A", "text": "2 km"}, {"label": "B", "text": "3 km"}, {"label": "C", "text": "4 km"}, {"label": "D", "text": "5 km"}, {"label": "E", "text": "6 km"}], "correct_answer": "B", "answer_reason": "Real distance = 6 × 50,000 = 300,000 cm = 3 km.", "order_index": 16 },
      { "id": "tqr-q18", "stem": "A mixture contains salt and water in the ratio 2:9. If there are 180 ml of water, how much salt is there?", "options": [{"label": "A", "text": "20 ml"}, {"label": "B", "text": "30 ml"}, {"label": "C", "text": "36 ml"}, {"label": "D", "text": "40 ml"}, {"label": "E", "text": "45 ml"}], "correct_answer": "D", "answer_reason": "Salt : Water = 2:9. If water = 180 ml, salt = (2/9) × 180 = 40 ml.", "order_index": 17 },
      { "id": "tqr-q19", "stem": "A flight departs at 14:45 and arrives at 17:10 on the same day. How long is the flight?", "options": [{"label": "A", "text": "2 h 15 min"}, {"label": "B", "text": "2 h 25 min"}, {"label": "C", "text": "2 h 35 min"}, {"label": "D", "text": "2 h 45 min"}, {"label": "E", "text": "3 h 05 min"}], "correct_answer": "B", "answer_reason": "From 14:45 to 17:10 = 2 hours 25 minutes.", "order_index": 18 },
      { "id": "tqr-q20", "stem": "A company's profit increased from £80,000 to £92,000. What is the percentage increase?", "options": [{"label": "A", "text": "12%"}, {"label": "B", "text": "13%"}, {"label": "C", "text": "14%"}, {"label": "D", "text": "15%"}, {"label": "E", "text": "16%"}], "correct_answer": "D", "answer_reason": "Increase = £12,000. Percentage = (12,000 ÷ 80,000) × 100 = 15%.", "order_index": 19 },
      { "id": "tqr-q21", "stem": "A cube has a side length of 5 cm. What is its total surface area?", "options": [{"label": "A", "text": "100 cm²"}, {"label": "B", "text": "125 cm²"}, {"label": "C", "text": "150 cm²"}, {"label": "D", "text": "175 cm²"}, {"label": "E", "text": "200 cm²"}], "correct_answer": "C", "answer_reason": "Surface area = 6 × (5²) = 6 × 25 = 150 cm².", "order_index": 20 },
      { "id": "tqr-q22", "stem": "A student scores 68% on a test with 75 questions. How many questions did they answer correctly?", "options": [{"label": "A", "text": "48"}, {"label": "B", "text": "50"}, {"label": "C", "text": "51"}, {"label": "D", "text": "53"}, {"label": "E", "text": "55"}], "correct_answer": "C", "answer_reason": "0.68 × 75 = 51 questions.", "order_index": 21 },
      { "id": "tqr-q23", "stem": "£1,200 is shared between A and B so that A receives £200 more than B. How much does B receive?", "options": [{"label": "A", "text": "£450"}, {"label": "B", "text": "£480"}, {"label": "C", "text": "£500"}, {"label": "D", "text": "£520"}, {"label": "E", "text": "£550"}], "correct_answer": "C", "answer_reason": "B + (B + 200) = 1200 → 2B = 1000 → B = £500.", "order_index": 22 },
      { "id": "tqr-q24", "stem": "A cylinder has radius 4 cm and height 10 cm. What is its volume? (Use π ≈ 3.14)", "options": [{"label": "A", "text": "452.16 cm³"}, {"label": "B", "text": "480.00 cm³"}, {"label": "C", "text": "502.40 cm³"}, {"label": "D", "text": "510.32 cm³"}, {"label": "E", "text": "528.00 cm³"}], "correct_answer": "C", "answer_reason": "Volume = π × r² × h = 3.14 × 16 × 10 = 502.4 cm³.", "order_index": 23 },
      { "id": "tqr-q25", "stem": "A class of 30 students has a mean test score of 72. If 5 new students join with a mean of 60, what is the new class mean?", "options": [{"label": "A", "text": "68"}, {"label": "B", "text": "69"}, {"label": "C", "text": "69.7"}, {"label": "D", "text": "70"}, {"label": "E", "text": "71"}], "correct_answer": "C", "answer_reason": "Total = (30 × 72) + (5 × 60) = 2160 + 300 = 2460. New mean = 2460 ÷ 35 ≈ 70.3. Closest answer is C (69.7 is not exact — recalculate: 2460/35 = 70.29). Answer is D.", "correct_answer": "D", "answer_reason": "Total = (30 × 72) + (5 × 60) = 2,460. New mean = 2,460 ÷ 35 ≈ 70.", "order_index": 24 },
      { "id": "tqr-q26", "stem": "A shop buys a watch for £85 and sells it for £119. What is the percentage profit?", "options": [{"label": "A", "text": "36%"}, {"label": "B", "text": "38%"}, {"label": "C", "text": "40%"}, {"label": "D", "text": "42%"}, {"label": "E", "text": "44%"}], "correct_answer": "C", "answer_reason": "Profit = £34. Percentage = (34 ÷ 85) × 100 = 40%.", "order_index": 25 },
      { "id": "tqr-q27", "stem": "A tap fills a 360-litre tank at 12 litres per minute. Another tap drains it at 4 litres per minute. How long to fill the tank from empty with both taps open?", "options": [{"label": "A", "text": "30 min"}, {"label": "B", "text": "40 min"}, {"label": "C", "text": "45 min"}, {"label": "D", "text": "50 min"}, {"label": "E", "text": "60 min"}], "correct_answer": "C", "answer_reason": "Net fill rate = 12 − 4 = 8 L/min. Time = 360 ÷ 8 = 45 minutes.", "order_index": 26 },
      { "id": "tqr-q28", "stem": "The exchange rate is £1 = €1.18. How many pounds is €531?", "options": [{"label": "A", "text": "£420"}, {"label": "B", "text": "£430"}, {"label": "C", "text": "£440"}, {"label": "D", "text": "£450"}, {"label": "E", "text": "£460"}], "correct_answer": "D", "answer_reason": "Pounds = 531 ÷ 1.18 = £450.", "order_index": 27 },
      { "id": "tqr-q29", "stem": "A box contains 4 red, 6 blue, and 2 yellow balls. One is picked at random. What is the probability it is blue?", "options": [{"label": "A", "text": "1/4"}, {"label": "B", "text": "1/3"}, {"label": "C", "text": "1/2"}, {"label": "D", "text": "2/3"}, {"label": "E", "text": "3/4"}], "correct_answer": "C", "answer_reason": "Total = 12 balls. Blue = 6. Probability = 6/12 = 1/2.", "order_index": 28 },
      { "id": "tqr-q30", "stem": "A car's fuel tank holds 50 litres. It currently has 14 litres. Petrol costs £1.62 per litre. How much does it cost to fill the tank?", "options": [{"label": "A", "text": "£54.00"}, {"label": "B", "text": "£56.16"}, {"label": "C", "text": "£58.32"}, {"label": "D", "text": "£60.48"}, {"label": "E", "text": "£62.64"}], "correct_answer": "C", "answer_reason": "Litres needed = 50 − 14 = 36. Cost = 36 × £1.62 = £58.32.", "order_index": 29 },
      { "id": "tqr-q31", "stem": "A triangle has a base of 18 cm and a height of 11 cm. What is its area?", "options": [{"label": "A", "text": "88 cm²"}, {"label": "B", "text": "90 cm²"}, {"label": "C", "text": "96 cm²"}, {"label": "D", "text": "99 cm²"}, {"label": "E", "text": "108 cm²"}], "correct_answer": "D", "answer_reason": "Area = ½ × base × height = ½ × 18 × 11 = 99 cm².", "order_index": 30 },
      { "id": "tqr-q32", "stem": "A nurse works 4 days on, 2 days off. She starts her cycle on a Monday. What day does her 3rd day off fall?", "options": [{"label": "A", "text": "Sunday"}, {"label": "B", "text": "Monday"}, {"label": "C", "text": "Tuesday"}, {"label": "D", "text": "Wednesday"}, {"label": "E", "text": "Thursday"}], "correct_answer": "A", "answer_reason": "Cycle: Mon–Thu work, Fri–Sat off (days off 1–2). Second cycle: Sun–Wed work, Thu–Fri off (days off 3–4). 3rd day off = Thursday. Answer: E.", "correct_answer": "E", "answer_reason": "Days off: Fri (1st), Sat (2nd), Thu (3rd). 3rd day off = Thursday.", "order_index": 31 },
      { "id": "tqr-q33", "stem": "Two numbers are in the ratio 7:3. Their sum is 120. What is the larger number?", "options": [{"label": "A", "text": "72"}, {"label": "B", "text": "78"}, {"label": "C", "text": "80"}, {"label": "D", "text": "84"}, {"label": "E", "text": "90"}], "correct_answer": "D", "answer_reason": "Larger = (7/10) × 120 = 84.", "order_index": 32 },
      { "id": "tqr-q34", "stem": "A project is 40% complete after 12 days. At the same rate, how many more days are needed to finish?", "options": [{"label": "A", "text": "14"}, {"label": "B", "text": "16"}, {"label": "C", "text": "18"}, {"label": "D", "text": "20"}, {"label": "E", "text": "22"}], "correct_answer": "C", "answer_reason": "Rate = 40% in 12 days. Remaining 60% at same rate = (60/40) × 12 = 18 days.", "order_index": 33 },
      { "id": "tqr-q35", "stem": "A car depreciates by 15% per year. If it is worth £18,000 now, what will it be worth in 2 years?", "options": [{"label": "A", "text": "£12,600"}, {"label": "B", "text": "£12,870"}, {"label": "C", "text": "£13,005"}, {"label": "D", "text": "£13,230"}, {"label": "E", "text": "£13,500"}], "correct_answer": "C", "answer_reason": "After 1 year: 18,000 × 0.85 = £15,300. After 2 years: 15,300 × 0.85 = £13,005.", "order_index": 34 },
      { "id": "tqr-q36", "stem": "The mean of five numbers is 14. Four of them are 10, 12, 16, and 18. What is the fifth number?", "options": [{"label": "A", "text": "12"}, {"label": "B", "text": "13"}, {"label": "C", "text": "14"}, {"label": "D", "text": "15"}, {"label": "E", "text": "16"}], "correct_answer": "C", "answer_reason": "Sum = 5 × 14 = 70. Known sum = 10 + 12 + 16 + 18 = 56. Fifth = 70 − 56 = 14.", "order_index": 35 }
    ]
  }
]

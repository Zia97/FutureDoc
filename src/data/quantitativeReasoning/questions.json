    {
      "setId": "qr_003",
      "title": "City Council Annual Budget",
      "stimulus": {
        "type": "pie_chart",
        "data": {
          "title": "City Council Annual Budget Allocation (£ millions, Total: £240m)",
          "total": 240,
          "unit": "£",
          "segments": [
            { "label": "Housing", "value": 72 },
            { "label": "Transport", "value": 60 },
            { "label": "Education", "value": 48 },
            { "label": "Health", "value": 36 },
            { "label": "Other", "value": 24 }
          ]
        }
      },
      "questions": [
        {
          "questionId": "qr_003_q1",
          "questionText": "How much more is allocated to Housing than to Health? (£ millions)",
          "options": [
            { "label": "A", "text": "£24m" },
            { "label": "B", "text": "£30m" },
            { "label": "C", "text": "£36m" },
            { "label": "D", "text": "£42m" },
            { "label": "E", "text": "£48m" }
          ],
          "answer": "C",
          "answeringReason": "Housing = £72m, Health = £36m. Difference = 72 − 36 = £36m."
        },
        {
          "questionId": "qr_003_q2",
          "questionText": "What percentage of the total budget is allocated to Transport and Education combined?",
          "options": [
            { "label": "A", "text": "35%" },
            { "label": "B", "text": "40%" },
            { "label": "C", "text": "42%" },
            { "label": "D", "text": "45%" },
            { "label": "E", "text": "50%" }
          ],
          "answer": "D",
          "answeringReason": "Transport £60m + Education £48m = £108m. (108 ÷ 240) × 100 = 45%."
        },
        {
          "questionId": "qr_003_q3",
          "questionText": "If the total budget increases by 25% next year and percentage allocations remain unchanged, what will the Health allocation be?",
          "options": [
            { "label": "A", "text": "£40m" },
            { "label": "B", "text": "£42m" },
            { "label": "C", "text": "£44m" },
            { "label": "D", "text": "£45m" },
            { "label": "E", "text": "£48m" }
          ],
          "answer": "D",
          "answeringReason": "Health = 36/240 = 15% of budget. New total = £240m × 1.25 = £300m. New Health = 15% × £300m = £45m."
        },
        {
          "questionId": "qr_003_q4",
          "questionText": "If the Housing allocation is increased by £12m while the total budget remains £240m, what percentage will Housing then represent?",
          "options": [
            { "label": "A", "text": "30%" },
            { "label": "B", "text": "32%" },
            { "label": "C", "text": "33%" },
            { "label": "D", "text": "34%" },
            { "label": "E", "text": "35%" }
          ],
          "answer": "E",
          "answeringReason": "New Housing = £72m + £12m = £84m. (84 ÷ 240) × 100 = 35%."
        }
      ]
    },

